# Supabase Configuration
# Dapatkan credentials dari: https://supabase.com/dashboard/project/_/settings/api

SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxx...

# Cara pakai:
# 1. Copy file ini jadi .env (jangan commit .env!)
# 2. Isi dengan credentials project Supabase Anda
# 3. Run dengan: flutter run --dart-define=SUPABASE_URL=xxx --dart-define=SUPABASE_PUBLISHABLE_KEY=xxx
# 4. Atau edit .vscode/launch.json dan pilih "Supabase Mode"
